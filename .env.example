# ============================================================
# Product Decision Advisor — Environment Configuration
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below (NEVER commit .env)
# 3. For Cloud Run, set these as env vars in the deploy command
#    or via Secret Manager (recommended for production)

# ------------------------------------------------------------
# AUTHENTICATION — choose ONE option
# ------------------------------------------------------------

# OPTION A: Vertex AI (recommended for Cloud Run)
# Run `gcloud auth application-default login` once locally.
# On Cloud Run, the service account handles this automatically.
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# gemini-3-flash-preview requires "global" location (not us-central1)
GOOGLE_CLOUD_LOCATION=global

# OPTION B: Gemini API key (Google AI Studio — local dev only)
# DO NOT use API keys in Cloud Run; use Vertex AI + service account instead.
# GOOGLE_API_KEY=your-api-key-here

# ------------------------------------------------------------
# CLOUD RUN — required for production deployment
# ------------------------------------------------------------

# CORS: comma-separated list of allowed frontend origins.
# WARNING: leaving this unset allows ALL origins — set it in production.
# Example: ALLOW_ORIGINS=https://your-frontend.web.app,https://your-domain.com
# ALLOW_ORIGINS=

# GCS bucket for ADK artifact storage (created by Terraform or manually)
# LOGS_BUCKET_NAME=your-gcs-bucket-name

# ------------------------------------------------------------
# OPTIONAL TUNING
# ------------------------------------------------------------

# Hard cap on search_transcripts calls per invocation.
# Default: 2. Increase to 3 for compound questions needing more evidence.
# Requires redeploy to take effect on Cloud Run.
# MAX_SEARCH_CALLS=2

# ------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY
# ------------------------------------------------------------
# ALLOW_ORIGINS=http://localhost:8501
